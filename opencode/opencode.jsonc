{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/Free Pickles",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute FREE ONLY",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:MALIKS_OMNIROUTE_KEY}"
      },
      "models": {
        "Free Pickles": { "name": "⭐ Free Pickles (8x combo - BEST)" },
        "oc/big-pickle": { "name": "🥒 0-Free Pickles / Big Pickle - FAST FREE" },
        "oc/deepseek-v4-flash-free": { "name": "⚡ DeepSeek V4 Flash - FREE FAST" },
        "oc/minimax-m3-free": { "name": "MiniMax M3 - FREE" },
        "oc/minimax-m2.5-free": { "name": "MiniMax M2.5 - FREE" },
        "oc/qwen3.6-plus-free": { "name": "Qwen3 6 Plus - FREE FAST" },
        "oc/nemotron-3-super-free": { "name": "Nemotron 3 Super - FREE" },
        "oc/trinity-large-preview-free": { "name": "Trinity Large - FREE" },
        "oc/ling-2.6-1t-free": { "name": "Ling 2.6 1T - FREE" },
        "auto/best-free": { "name": "🤖 Auto Best FREE - Best Router" },
        "auto/coding:free": { "name": "💻 Auto Coding FREE - Best Coding" },
        "auto/best-fast": { "name": "⚡ Auto Fast FREE" },
        "auto/best-reasoning": { "name": "🧠 Auto Reasoning FREE" }
      }
    }
  },
  "mcp": {
    "headroom": { "type": "local", "command": ["headroom", "mcp", "serve"] },
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "headers": { "Authorization": "Bearer {env:CONTEXT7_API_KEY}" } },
    "github": { "type": "local", "command": ["npx", "-y", "@modelcontextprotocol/server-github"], "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}" } },
    "playwright": { "type": "local", "command": ["npx", "-y", "@playwright/mcp"] },
    "fetch": { "type": "local", "command": ["uvx", "mcp-server-fetch"] }
  }
}
